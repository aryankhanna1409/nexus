# nexus configuration. `make env` copies this to .env and fills in AEGIS_API_TOKENS and
# POSTGRES_PASSWORD with generated values. Never commit .env.

# API tokens as name:role:sha256hex, comma-separated (scripts/hash_token.py). Roles: viewer, operator, approver, admin.
AEGIS_API_TOKENS=

# Load the seeded demo incident on first start of the Docker stack.
AEGIS_BOOTSTRAP_DEMO=true

# LLM provider: mock (offline, default), anthropic (Claude), nim (NVIDIA NIM), openai, local
LLM_PROVIDER=mock
MODEL_NAME=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
# Hosted NIM by default; set this for a self-hosted NIM container, e.g. http://nim:8000/v1
NIM_BASE_URL=
OPENAI_API_KEY=
LOCAL_LLM_BASE_URL=

# DevSecOps agent
# playbook: fixed, deterministic steps. llm: the configured model picks each step (playbook as fallback).
AGENT_PLANNER=playbook
# true: the agent approves and executes its own actions and starts on every new incident. No human in the loop.
AGENT_AUTONOMOUS=false
# Allow HIGH_RISK actions such as production rollback (needs approval + admin, or AGENT_AUTONOMOUS).
AGENT_ALLOW_HIGH_RISK=false

AEGIS_RATE_LIMIT_PER_MINUTE=600
LOG_LEVEL=INFO
